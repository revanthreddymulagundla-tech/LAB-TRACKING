{
  "name": "labtrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LabTrack – Smart Lab Examination Schedule Portal (2026-27 Odd Sem)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.mjs",
    "test:data": "node scripts/verify-data.mjs",
    "test:app": "esbuild scripts/test-app.mjs --bundle --platform=node --format=esm --loader:.js=jsx --loader:.jsx=jsx --jsx=automatic --packages=external --outfile=.test-build.mjs --log-level=error && node .test-build.mjs",
    "test": "npm run test:data && npm run test:app"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
